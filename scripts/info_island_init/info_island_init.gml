function info_island_init(){
	register_card_info_island("small_fire","基础能力：放置1秒后立即生产一朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出一朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：能量消耗降低至25。\n\n二转能力：一次可产出两朵火苗。")
	register_card_info_island("xiao_long_bao","基础能力：当前方一行内出现敌人时，就会每隔[攻击间隔]秒直线发射一个\n伤害为[攻击力]的包子。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("toast_bread","基础能力：体力比一般的卡片大，可以抵御老鼠的攻击。\n *星级影响[生命值]，技能影响[冷却时间]。")
	register_card_info_island("flour_sack","基础能力：当左右一格出现敌人时，会砸击目标，直接秒杀不防爆的老鼠，\n并对防爆的老鼠造成相当于[攻击力]的伤害。\n -面粉袋免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：索敌范围增加到左右各两格，发现目标后会召唤两个分身，伤害\n范围增加至三格。\n\n二转能力：索敌范围增加到左右各三格，发现目标后会召唤四个分身，伤害\n范围增加至五格。")
	register_card_info_island("double_long_bao","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会直线发射两个\n伤害为[攻击力]的包子。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("mouse_clip","基础能力：经过[攻击间隔]秒的准备后，如果被地面敌人接触，则会产生单\n格爆炸，直接秒杀不防爆的老鼠，并对防爆的老鼠造成相当于[攻击力]的伤\n害。准备完成后，如果老鼠夹子死亡或被铲除，则会立即爆炸。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n一转能力：可以被空中单位触发。\n\n二转能力：爆炸范围增加至3*4。")
	register_card_info_island("coke_bomb","基础能力：放置后，会在短暂前摇后产生3*4范围的爆炸，直接秒杀不防爆\n的老鼠，并对防爆的老鼠造成相当于[攻击力]的伤害。如果在前摇期间死亡\n或被铲除，则会立即爆炸。\n -可乐炸弹免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：[攻击力]额外增加30%。\n\n二转能力：爆炸后会留下一片火焰，每秒造成100点伤害，持续3秒。")
	register_card_info_island("wooden_plate","基础能力：可以放置在水上，用于承载陆地卡片。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：能量消耗降低至0。\n\n二转能力：[生命值]额外增加100%，每次放置时会同时在上下两侧的空位上\n生成一个新的木盘子。")
	register_card_info_island("ice_long_bao","基础能力：当前方一行内出现敌人时，就会每隔[攻击间隔]秒直线发射一个\n伤害为[攻击力]的冰包子，冰包子会对目标造成10秒的50%减速效果。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("goblet_lamp","基础能力：放置1秒后立即生产一朵价值为[火苗产量-10]的小火苗，随后每\n隔[攻击间隔]秒，就会产出一朵小火苗。90秒后，酒杯灯会长大，转而生产\n价值为[火苗产量]的正常火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：能量消耗降低至15。\n\n二转能力：一次可产出两朵火苗。")
	register_card_info_island("coffee_cup","基础能力：当前方三格内出现敌人时，每隔[攻击间隔]秒，就会直线发射一\n发伤害为[攻击力]的咖啡弹，咖啡弹会在飞行三格后消失。\n -咖啡杯在白天会睡觉。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加30%，且白天不再睡觉。\n\n二转能力：攻击距离提升至一整行。")
	register_card_info_island("salad_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一颗番茄，\n番茄会对主目标造成等同于[攻击力]的伤害，随后弹射一次，对1*3范围内\n的其他目标造成50%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：溅射伤害提高至80%。\n\n二转能力：每次攻击可投掷两颗番茄。")
	register_card_info_island("coffee_pot","基础能力：当前方四格内出现敌人时，每隔[攻击间隔]秒，就会喷射一束伤\n害为[攻击力]的咖啡喷雾，咖啡喷雾会伤害范围内的所有敌人并穿透手持防\n具。\n -咖啡喷壶在白天会睡觉。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加30%，且白天不再睡觉。\n\n二转能力：攻击距离提升至一整行。")
	register_card_info_island("chocolate_bread","基础能力：体力比一般的卡片大，可以抵御老鼠的攻击，并且可以阻止敌人\n翻越自己。\n -场上每存在一个巧克力面包，自身的[能量消耗]就会增加50点。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：能量守恒，[能量消耗]不再增加。")
	register_card_info_island("water_tea_cup","基础能力：只能放置在水上，当前方三格内出现敌人时，每隔[攻击间隔]秒，\n就会直线发射一发伤害为[攻击力]的咖啡弹，咖啡弹会在飞行三格后消失。\n -水上茶杯在白天会睡觉。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("ice_bucket_bomb","基础能力：放置后，会在短暂前摇后为全屏敌人施加[攻击间隔]秒的冰冻效\n果和20秒的减速效果，同时造成[攻击力]点伤害。如果在前摇期间死亡或被\n铲除，则会立即爆炸。\n -冰桶炸弹在白天会睡觉。\n -冰桶炸弹在前摇期间免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]增加至300，减速时间增加至25秒。\n\n二转能力：爆炸时造成3*4范围的冰爆效果，对范围内敌人造成双倍的伤害、\n冰冻时间和减速时间。")
	register_card_info_island("stinky_tofu_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，如果臭豆腐冷却完\n毕，就会投掷一块伤害为[攻击力]的臭豆腐，臭豆腐会在落点处留下一片\n3*3范围的毒雾，每秒造成35%[攻击力]的伤害，持续3秒。否则，投掷一块\n伤害为[攻击力]的红豆腐，红豆腐没有特殊效果。臭豆腐的冷却时间为8秒。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：毒雾伤害提高至50%。\n\n二转能力：每次攻击可投掷两块豆腐，臭豆腐冷却时间降低至5秒。")
	register_card_info_island("cat_box","基础能力：被老鼠啃咬后，会将其惊吓至相邻行。老鼠无法在水路和陆路之\n间转移。\n *星级影响[生命值]，技能影响[冷却时间]。")
	register_card_info_island("kettle_bomb","基础能力：放置后，会在短暂前摇后产生5*5范围的爆炸，直接秒杀不防爆\n的老鼠，并对防爆的老鼠造成相当于[攻击力]的伤害。如果在前摇期间死亡\n或被铲除，则会立即爆炸。\n -开水壶炸弹在白天会睡觉。\n -开水壶炸弹在前摇期间免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：[攻击力]额外增加30%。\n\n二转能力：对范围内敌人额外造成10秒的50%减速，且白天不再睡觉。")
	register_card_info_island("fishbone","基础能力：当有敌人接触到自己时，会每隔[攻击间隔]秒对所有接触到的敌\n人造成[攻击力]点伤害，并且可以直接摧毁接触到自己的车辆，摧毁一个车\n辆后自身消失。\n -鱼刺不会被敌人啃食。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("triple_wine_rack","基础能力：当前方三行内出现敌人时，每隔[攻击间隔]秒，就会向前方三行\n分别直线发射一个伤害为[攻击力]的葡萄酒弹。如果三线酒架被放置在边路，\n则原本要射出地图外的子弹会补偿在边路上。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：中间增加一发葡萄酒弹，共计4发。\n\n二转能力：两边各增加一发葡萄酒弹，共计6发。")
	register_card_info_island("brazier","基础能力：点燃经过自己的大多数直线子弹，使它们的伤害乘以自身的[攻\n击力]。冰弹会失去减速效果，且无法享受伤害加成。\n *星级影响[攻击力]，技能影响[生命值]。\n\n一转能力：[生命值]额外增加400%。\n\n二转能力：[攻击力]额外增加20%。")
	register_card_info_island("large_fire","基础能力：放置1秒后立即生产两朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出两朵火苗。\n -场上每存在一个大火炉，自身的[能量消耗]就会增加50点。\n -大火炉只能放置在小火炉上。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：每次生产的火苗量增加至三朵。\n\n二转能力：能量守恒，[能量消耗]不再增加，且无需底座即可直接放置。")
	register_card_info_island("iron_fishbone","基础能力：当有敌人接触到自己时，会每隔[攻击间隔]秒对所有接触到的敌\n人造成[攻击力]点伤害，并且可以直接摧毁接触到自己的车辆，摧毁四个车\n辆后自身消失。\n -钢鱼刺不会被敌人啃食。\n -场上每存在一个钢鱼刺，自身的[能量消耗]就会增加50点。\n -钢鱼刺只能放置在鱼刺上。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒，[能量消耗]不再增加，且无需底座即可直接放置。\n\n二转能力：每次攻击会让目标进入12秒的50%减速效果。")
	register_card_info_island("gatlin_long_bao","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会直线发射四个\n伤害为[攻击力]的包子。\n *星级影响[攻击力]，技能影响[冷却时间]。\n -场上每存在一个机枪小笼包，自身的[能量消耗]就会增加50点。\n -机枪小笼包只能放置在双层小笼包上。\n\n一转能力：能量守恒，[能量消耗]不再增加。\n\n二转能力：每次发射的包子增加至6个，且无需底座即可直接放置。")
	register_card_info_island("rotating_coffee_pot","基础能力：当自身周围3*3范围内出现敌人时，每隔[攻击间隔]秒，就会旋\n转喷射一圈伤害为[攻击力]的咖啡喷雾，咖啡喷雾会伤害范围内的所有敌人\n并穿透手持防具。\n -旋转咖啡喷壶在白天会睡觉。\n -场上每存在一个旋转咖啡喷壶，自身的[能量消耗]就会增加50点。\n -旋转咖啡喷壶只能放置在咖啡喷壶上。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：能量守恒，[能量消耗]不再增加，且无需底座即可直接放置。\n\n二转能力：攻击范围提升至5*5,[攻击力]额外增加100%，且白天不再睡觉。")
	register_card_info_island("takoyaki","基础能力：当屏幕内出现敌人时，每隔[攻击间隔]秒，就会甩出两个具有追\n踪能力的飞镖，章鱼烧会优先处理靠近自己的敌人，如果右侧一格内没有敌\n人，则飞镖会优先锁定最靠左且生命值最高的目标。如果命中前目标就已死\n亡，则会继续锁定下一个目标。飞镖可以锁定空中目标。\n -场上每存在一个章鱼烧，自身的[能量消耗]就会增加50点。\n -章鱼烧只能放置在木盘子上。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：允许在陆地上放置，且可以直接在水上放置，无需木盘子。\n\n二转能力：能量守恒，[能量消耗]不再增加，且每次甩出的飞镖增加至4个，\n[攻击间隔]降低至1.5秒。")
	register_card_info_island("wine_bottle_bomb","基础能力：放置后，会在短暂前摇后产生整行范围的爆炸，直接秒杀不防爆\n的老鼠，并对防爆的老鼠造成相当于[攻击力]的伤害。如果在前摇期间死亡\n或被铲除，则会立即爆炸。\n -酒瓶炸弹免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：[攻击力]额外增加30%。\n\n二转能力：爆炸范围扩大为本行+本列的十字形范围。")
	register_card_info_island("egg_boiler_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个鸡蛋，\n鸡蛋会对主目标造成等同于[攻击力]的伤害，并对3*3范围内的其他目标造\n成35%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：溅射伤害提高至50%。\n\n二转能力：每次攻击可投掷两个鸡蛋。")
	register_card_info_island("double_water_pipe","基础能力：本行内，自身前方或后方出现敌人时，每隔[攻击间隔]秒，就会\n同时向前后两个方向直线发射伤害为[攻击力]的水弹，前方为1发，后方为\n2发。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：前方增加1发水弹。\n\n二转能力：前后两方各增加1发水弹。")
	register_card_info_island("melon_shield","基础能力：为被罩住的卡片抵挡伤害。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：受伤时，会将受到的伤害等额返还给3*3范围内的所有敌人。被\n铲除时会立即释放相当于自身剩余[生命值]的伤害。\n\n二转能力：每秒恢复10点[生命值]，受伤时会立即回复相当于此次受伤量\n50%的[生命值]。")
	register_card_info_island("ice_egg_boiler_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个冰鸡\n蛋，冰鸡蛋会对主目标造成等同于[攻击力]的伤害，并对3*3范围内的其他\n目标造成25%的溅射伤害，范围内的所有敌人都会受到10秒的50%减速效果。\n -场上每存在一个冰煮蛋器，自身的[能量消耗]就会增加50点。\n -冰煮蛋器只能放置在煮蛋器投手上。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒，[能量消耗]不再增加。\n\n二转能力：溅射范围提高至5*5，且无需底座即可直接放置。")
	register_card_info_island("coffee_grounds","基础能力：唤醒本格卡片，并使其在接下来的[攻击间隔]秒内免疫催眠效果。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n一转能力：唤醒范围扩大至3*3，能量消耗降低至25。\n\n二转能力：唤醒范围扩大至地图内所有卡片。")
	register_card_info_island("hamburger","基础能力：当自身前方一格出现敌人时，如果该敌人不防爆，则会直接将其\n吃掉，并进入[攻击间隔]秒的咀嚼状态，期间不能发动攻击。如果敌人防爆，\n则会进行啃咬攻击，每次会造成[攻击力]点伤害。汉堡包每次只能攻击或吃\n掉一个敌人。\n *星级影响[攻击间隔]和[攻击力]，技能影响[生命值]。\n\n一转能力：索敌范围扩大至前方三格，且一次能吃掉或攻击范围内的所有敌\n人。\n\n二转能力：攻击或吃掉敌人时，会在自身前方一格处产生一片3*3范围的毒\n雾，每秒对其中敌人造成[攻击力]点伤害，持续3秒。")
	register_card_info_island("steel_wool","基础能力：当自身前方一格出现敌人时，如果该敌人不防爆，则会将其拖入\n水中，如果敌人防爆，则会对其造成造成[攻击力]点伤害。钢丝球只能攻击\n一个敌人。\n *星级影响[冷却时间]，技能影响[攻击力]。")
	register_card_info_island("wooden_cork","基础能力：可以移除本格的老鼠洞。\n *星级影响[能量消耗]，技能影响[冷却时间]。")
	register_card_info_island("sausage","基础能力：当前方一行出现空中或地面敌人时，每隔[攻击间隔]秒，就会直\n线发射一块伤害为[攻击力]的香肠。香肠能够伤害空中敌人。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("oil_lamp","基础能力：照亮半径3格范围内的迷雾，并使3*3范围内的隐形敌人显形。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：照亮迷雾和使隐形敌人显形的范围扩大至全屏。")
	register_card_info_island("ventilation_fan","基础能力：吹走迷雾，使其在[攻击间隔]秒后返回，并且可以吹走场上所有\n不防爆的空中敌人，对于防爆的空中敌人造成[攻击力]点伤害并击退。\n -换气扇免疫敌人的啃咬和砸击伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：击退效果可以应用于本行的陆地敌人。\n\n二转能力：对于防爆的空军造成的伤害提高至2倍[攻击力]，并造成双倍击\n退距离，对于本行其余敌人造成0.5倍[攻击力]的伤害")
	register_card_info_island("chocolate_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个伤害\n为[攻击力]的巧克力豆。每投掷两次，第三次攻击会投出伤害为2倍[攻击力\n]的巧克力块，巧克力块会定住敌人4秒。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：巧克力块的定身时长增加至7秒。\n\n二转能力：每次攻击可投掷两块巧克力。")
	register_card_info_island("chocolate_cannon","基础能力：每隔[攻击间隔]秒，就会发射一枚巧克力球，巧克力球会落在本\n行第九列，造成3*3范围的爆炸效果，秒杀不防爆的老鼠，对防爆的老鼠造\n成[攻击力]点伤害。\n -场上每存在一个巧克力大炮，自身的[能量消耗]就会增加50点。\n -巧克力大炮只能放置在巧克力投手上。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n一转能力：能量守恒，[能量消耗]不再增加。\n\n二转能力：每次攻击可以发射两枚巧克力球，且无需底座即可直接放置。")
	register_card_info_island("firework_dragon","基础能力：放置1秒后立即产出6朵价值为[火苗产量]的火苗，随后消失。\n -花火龙免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[火苗产量]。\n\n一转能力：能量消耗降低至0。\n\n二转能力：生产的火苗数提升至12朵。")
	register_card_info_island("cherry_pudding","基础能力：将大多数命中自己的直射子弹反弹至相反的方向，并使它们的伤\n害增加[攻击力]点。每个子弹只能被反弹一次。\n *星级影响[攻击力]和[生命值]，技能影响[冷却时间]。\n\n一转能力：[能量消耗]降低至75。\n\n二转能力：[攻击力]额外增加100%。")
	register_card_info_island("double_ice_long_bao","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会直线发射两个\n伤害为[攻击力]的冰包子，冰包子会对目标造成10秒的50%减速效果。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("cat_chest","基础能力：被老鼠啃咬后，会将其惊吓至相邻行，同时对其造成[攻击力]点\n伤害，并使其丢弃手持防具。老鼠无法在水路和陆路之间转移。\n *星级影响[生命值]和[攻击力]，技能影响[冷却时间]。")
	register_card_info_island("skewer_bomb","基础能力：被空中敌人接触后，产生一次仅对空中单位生效的单格范围爆炸，\n秒杀不防爆的老鼠，对防爆的老鼠造成[攻击力]点伤害。如果死亡或被铲除，\n则会立即爆炸。\n *星级影响[冷却时间]，技能影响[攻击力]。")
	register_card_info_island("gatlin_ice_long_bao","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会直线发射四个\n伤害为[攻击力]的冰包子，冰包子会对目标造成10秒的50%减速效果。\n -场上每存在一个机枪冰冻小笼包，自身的[能量消耗]就会增加50点。\n -机枪冰冻小笼包只能放置在双层冰冻小笼包上。\n *星级影响[攻击力]，技能影响[冷却时间]。")
	register_card_info_island("aquarius_elve","基础能力：放置后，会在短暂前摇后分别在本行5格和本列5格范围内产生两\n次爆炸效果，每次爆炸都会直接秒杀不防爆的老鼠，并对防爆的老鼠造成相\n当于[攻击力]的伤害。如果在前摇期间死亡或被铲除，则会立即爆炸。\n -水瓶座精灵免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：[攻击力]额外增加30%。\n\n二转能力：纵向爆炸范围增加至一整列。")
	register_card_info_island("durian","基础能力：放置后，每秒产生一片3*3范围的毒雾，对范围内的敌人造成[攻\n击力]点伤害，持续[攻击间隔]秒后自身消失。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：对命中的敌人造成4秒的50%减速效果。\n\n二转能力：攻击范围扩大至5*5。")
	register_card_info_island("dragon_fruit","基础能力：放置后，每4秒产生一片3*3范围的火焰，对范围内的敌人造成[\n攻击力]点伤害，攻击3次后自身消失。火焰无法伤害空中敌人。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：火焰能够伤害空中敌人。\n\n二转能力：攻击范围扩大至5*5。")
	register_card_info_island("tar_sprayer","基础能力：当前方四格内出现敌人时，每隔[攻击间隔]秒，就会喷射一束伤\n害为[攻击力]的油滴，油滴会伤害范围内的所有敌人并穿透手持防具，并且\n可以被火盆点燃。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：攻击范围扩大至6格。\n\n二转能力：[攻击力]额外增加100%。")
	register_card_info_island("durian","基础能力：放置后，每秒产生一片3*3范围的毒雾，对范围内的敌人造成[攻\n击力]点伤害，持续[攻击间隔]秒后自身消失。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：对命中的敌人造成4秒的50%减速效果。\n\n二转能力：攻击范围扩大至5*5。")
	register_card_info_island("dragon_fruit","基础能力：放置后，每4秒产生一片3*3范围的火焰，对范围内的敌人造成[\n攻击力]点伤害，攻击3次后自身消失。火焰无法伤害空中敌人。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：火焰能够伤害空中敌人。\n\n二转能力：攻击范围扩大至5*5。")
	register_card_info_island("warm_birds","基础能力：放置1秒后立即生产三朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出三朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：一次可产出四朵火苗。\n\n二转能力：一次可产出五朵火苗，冷却时间减半。")
	register_card_info_island("sea_star","基础能力：场上出现敌人时，每隔[攻击间隔]秒向五个触角的方向发射一枚\n伤害为[攻击力]的炭烧海星子弹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量消耗减半。\n\n二转能力：每个方向额外增加一枚子弹，子弹可以反弹。")
	register_card_info_island("tanghulu","基础能力：当场上出现空中敌人时，每隔[攻击间隔]秒发射一颗追踪的糖葫\n芦炮弹，对敌人造成[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加20%。\n\n二转能力：一次发射两颗追踪炮弹。")
	register_card_info_island("cold_drew","基础能力：当场上出现敌人时，每隔[攻击间隔]秒根据敌人数量发射至多四\n颗冰块子弹打击敌人，对敌人造成[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：可以发射的子弹增加一枚，每颗子弹获得20%溅射。\n\n二转能力：固定发射6枚冰块子弹，可集火。")
	register_card_info_island("triple_long_bao","基础能力：当右侧一行或者上下两侧出现敌人时，每隔[攻击间隔]秒，就会\n分别向右侧和上下两侧直线发射一个伤害为[攻击力]的包子。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("triple_ice_long_bao","基础能力：当右侧一行或者上下两侧出现敌人时，每隔[攻击间隔]秒，就会\n分别向右侧和上下两侧直线发射一个伤害为[攻击力]的冰包子，冰包子会对\n目标造成10秒的50%减速效果。\n *星级影响[攻击力]，技能影响[攻击间隔]。")
	register_card_info_island("hotdog_cannon","基础能力：当前方一行出现空中或地面敌人时，每隔[攻击间隔]秒，就会直\n线发射伤害为[攻击力]的冰导弹，对地面敌人为1发，对空中敌人为2发，冰\n导弹会对目标造成10秒的50%减速效果。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：对空导弹增加至3发。\n\n二转能力：对空导弹增加至4发，对地导弹增加至2发。")
	register_card_info_island("oden_pot","基础能力：当右侧四格内或者上下两侧四格内出现敌人时，每隔[攻击间隔]\n秒，就会分别向右侧和上下两侧喷射一束蒸汽，蒸汽会伤害范围内的所有敌\n人并穿透手持防具。\n -关东煮喷锅在白天会睡觉。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加30%，且白天不再睡觉。\n\n二转能力：攻击距离扩大至整行和整列。")
	register_card_info_island("whisky_bomb","基础能力：放置后，会在短暂前摇后产生一列范围的爆炸，直接秒杀不防爆\n的老鼠，并对防爆的老鼠造成相当于[攻击力]的伤害。如果在前摇期间死亡\n或被铲除，则会立即爆炸。\n -威士忌炸弹免疫敌人的啃咬和砸击伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：[攻击力]额外增加30%。\n\n二转能力：爆炸范围扩大至三列。")
	register_card_info_island("cotton_candy","基础能力：可以放置在岩浆和云层上，用于承载陆地卡片。放置在岩浆上时，\n可以让其上的卡片免疫岩浆伤害。放置在云层上时，可以填补本行3格范围\n内的云洞，填补一次后自身消失。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：能量消耗降低至0。\n\n二转能力：[生命值]额外增加100%，填补云洞的范围扩大至3*3，且填补三\n次才会消失。")
	register_card_info_island("berry_dessert","基础能力：为自身周围3x3范围内的追踪类卡片增伤，倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：增伤范围扩大至5x5。\n\n二转能力：[攻击力]固定增加30。")
	register_card_info_island("grilled_lizard_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个爆弹，\n爆弹会对主目标造成等同于[攻击力]的伤害，并对3*3范围内的其他目标造\n成35%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加45%。\n\n二转能力：每次攻击可投掷两个爆弹。")
	register_card_info_island("warm_birds","基础能力：放置1秒后立即生产三朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出三朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：一次可产出四朵火苗。\n\n二转能力：一次可产出五朵火苗，冷却时间减半。")
	register_card_info_island("sea_star","基础能力：场上出现敌人时，每隔[攻击间隔]秒向五个触角的方向发射一枚\n伤害为[攻击力]的炭烧海星子弹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量消耗减半。\n\n二转能力：每个方向额外增加一枚子弹，子弹可以反弹。")
	register_card_info_island("corn_shooter","基础能力：当前方一行内出现敌人时，就会每隔[攻击间隔]秒直线发射三颗\n伤害为[攻击力]的玉米（可过火）。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：增加三发子弹且能量守恒（不+）。\n\n二转能力：子弹威力增加30%。")
	register_card_info_island("tanghulu","基础能力：当场上出现空中敌人时，每隔[攻击间隔]秒发射一颗追踪的糖葫\n芦炮弹，对敌人造成[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加20%。\n\n二转能力：一次发射两颗追踪炮弹。")
    register_card_info_island("cold_drew","基础能力：当场上出现敌人时，每隔[攻击间隔]秒根据敌人数量发射至多四\n颗冰块子弹打击敌人，对敌人造成[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：可以发射的子弹增加一枚，每颗子弹获得20%溅射。\n\n二转能力：固定发射6枚冰块子弹，可集火。")
	register_card_info_island("grilled_lizard_pult","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个爆弹，\n爆弹会对主目标造成等同于[攻击力]的伤害，并对3*3范围内的其他目标造\n成35%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加45%。\n\n二转能力：每次攻击可投掷两个爆弹。")
    register_card_info_island("shuangzi","基础能力：放置后生产四朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出四朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：冷却时间减少。\n\n二转能力：一次可产出六朵火苗，冷却时间减少。")
    register_card_info_island("sheshou",  "基础能力：同时向正前方三行发射4发强力箭，中间2发，两边各1发\n，威力巨大！\n*星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒(不＋)。\n\n二转能力：攻击次数增加，每次攻击向前方三行各射\n出2发（共6发）强力子弹。");
	register_card_info_island("athena","基础能力：普通能力：高频率发射激光武器，全屏跟踪轰炸，强力范围伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：连射两发激光。")
	register_card_info_island("tiancheng","基础能力：对前后各发射3发强力子弹，威力与实力的象征。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：前后各增加1发子弹。")
	register_card_info_island("shuangyu","基础能力：投掷两发强力冰鱼并产生溅射伤害40%,威力强大。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+），[能量消耗]不再增加。\n\n二转能力：子弹威力提升35%。")
	register_card_info_island("juxie","基础能力：扔出4发强力大钳子，全屏跟踪，无死角攻击。。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）冷却减少。\n\n二转能力：增加2发子弹，冷却进一步减少。")
	register_card_info_island("shizi","基础能力：连续快速向周边发出猛烈攻击，海陆空交通管制。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：连续攻击两次。")
	register_card_info_island("jinniu","基础能力：凡是穿透它能变成火弹的子弹，威力伤害超强提升，冰弹除外。\n *星级影响[攻击提升倍率]，技能影响[冷却时间]。\n\n一转能力：耗能减少50。\n\n二转能力：威力进一步增加%")
	register_card_info_island("chunv","基础能力：保护被他罩住的卡片，对啃它的老鼠造成一定伤害，体力更高。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：爆破伤害增加30%。\n\n二转能力：爆破范围增加到5*5")
	register_card_info_island("tianxie","基础能力：猩红毒针，分裂式穿透攻击，对一行连续4格造成100%伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：增加一发毒针")
	register_card_info_island("baiyang","基础能力：释放一直白羊精灵，对陆地上的小老鼠造成毁灭性伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：降低能耗至200点，且无需格子放置。\n\n二转能力：增加上下两行，对三行鼠军造成伤害")
	register_card_info_island("mojie","基础能力：对3×3范围内造成巨大冰暴伤害，老鼠持续减速扣血，卡片存在一定\n时间后消失。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：[攻击间隔]减半。\n\n二转能力：增加攻击范围至5×5")
	register_card_info_island("sun_god","基础能力：产能突破极限，每隔一段\n[攻击间隔]产出6多火苗，放置后立即生产。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n三转能力：一次生产8朵火苗，冷却与耗火略微降低。\n\n四转能力：一次生产10朵火苗，冷却与耗火进一步降低。\n\n终转能力：一次生产12朵火苗，冷却与耗火大幅降低，首次产量翻倍")
	register_card_info_island("moon_god","基础能力：连续发射6发全屏追踪型攻击的子弹，海陆空兼顾。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加1发子弹。\n\n四转能力：每组首发的子弹变身超级子弹,\n超级子弹拥有200%伤害并对3×3范围内敌人造成75%溅射。\n\n终转能力：增加一发子弹，场上每个月神增加5%伤害，最高至145%")
	register_card_info_island("war_god","基础能力：前后方分别同时发射4发强力子弹，一共8发。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：前后增加1发子弹。\n\n四转能力：前方每四轮额外射出一发超级子弹，超级子弹拥有800%攻击力。\n\n终转能力：后方每四轮也额外射出一发超级子弹，超级子弹拥有1200%攻击力")
	register_card_info_island("hera","基础能力：保护被罩的卡片，反伤啃咬它的老鼠，消失后对5×5范围造成\n一次等同剩余生命值的物理伤害与等同最大生命值的爆炸伤害。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n三转能力：增加25%体力。\n\n四转能力：给被保护的卡片增加1000体力。\n\n终转能力：一次种植3个，优先正上与正下方")
	register_card_info_island("thor","基础能力：连续发出2发带有强力溅射伤害40%和减速效果的冰锤。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加1发冰锤，但攻击力降低，总伤害增加20%。\n\n四转能力：溅射伤害提升至45%，每3轮额外投出1发超级子弹，\n超级子弹拥有200%伤害。\n\n终转能力：每轮增加一发超级子弹，溅射伤害提升至100%")
	register_card_info_island("poseidon","基础能力：连续向周围5*5格发出2发水波攻击，范围伤害能力高度提升。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%并附加减速效果。\n\n四转能力：增加1发水波攻击。\n\n终转能力：范围提升至7×5，总伤害提升85%")
	register_card_info_island("love_god","基础能力：向正前方三行分别射出2发子弹，一共6发。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：中路增加1发子弹。\n\n四转能力：侧路各增加1发子弹。\n\n终转能力：每四轮额外发射三发超级子弹，\n超级子弹拥有300%伤害，且可穿透敌人与障碍")
	register_card_info_island("fire_god","基础能力：穿过后变成高温子弹，并且伤害能力得到飞升，冰弹无效。\n *星级影响[攻击提升倍率]，技能影响[冷却时间]。\n\n三转能力：伤害再度提升20%。\n\n四转能力：被火子弹击中后，对当前格的敌人附加50%火焰群伤\n\n终转能力：增幅倍率再次提升20%，被火子弹击中后，对3×3范围内的敌人\n附加80%火焰群伤，\n*被直接击中的目标也会受到该伤害。")
	register_card_info_island("brahma","基础能力：复制两张上一次放下的卡片，优先选择中心和上下\n两格。\n *星级影响[冷却时间]，技能无影响。\n\n三转能力：放置造成5x5灰烬爆炸。\n\n四转能力：额外复制一张卡片。\n\n终转能力：额外复制两张卡片。")
	register_card_info_island("zhurong","基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投出高温炎\n球，点燃身前3x3的地面，对上面的敌人持续造成[攻击力]的伤害。\n-祝融的射程为4格\n-每发子弹总计造成10次[攻击力]的伤害\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：[攻击力]额外提升30%，射程增加一格。\n\n四转能力：点燃范围扩大到5x5。\n\n终转能力：[攻击力]额外提升45%，点燃范围扩大到7x5。")
	register_card_info_island("zeus","基础能力：全屏发射两发强力闪电攻击，造成3×3强力范围伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%。\n\n四转能力：增加一发闪电。\n\n终转能力：增加两发闪电，范围变为5×5。")
	register_card_info_island("gaia","基础能力：当自身三行内出现敌人时，每隔[攻击间隔]秒，就会发射两枚\n毁灭巨石，在本行对应的敌人位置造成3*3范围的灰烬爆炸效果，造成\n[攻击力]点伤害。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n三转能力：攻击力提高，眩晕并初始瞬发。\n\n四转能力：增加1发子弹。\n\n终转能力：爆炸范围扩大至5*5。")
	register_card_info_island("ghost_god","基础能力：向五个方向分别发射一枚强力子弹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加一发附带减速和穿透的次级子弹，但伤害仅有20%。\n\n四转能力：攻击力提升，再增加一发次级子弹。\n\n终转能力：所有子弹变为次级子弹，但次级子弹现在拥有100%伤害。")
	register_card_info_island("ice_god","基础能力：召唤冰晶，攻击全屏8个敌人，附加减速。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：耗能减少，冰晶带有3程3的40%溅射伤害。\n\n四转能力：攻击力提升，攻击数量+2。\n\n终转能力：攻击力大幅提升，攻击数量＋2。")
	register_card_info_island("odin","基础能力：向前方发射两发穿透短矛子弹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升25%。\n\n四转能力：增加1发子弹。\n\n终转能力：再次增加1发子弹。")
    register_card_info_island("aurora","基础能力：为本行的投掷类卡片增加巨量攻击力。\n *星级影响[增幅倍率]，技能影响[冷却时间]\n\n三转能力：死后造成5×5灰烬爆炸，且体力大幅提升。\n\n四转能力：增幅倍率大幅提升。\n\n终转能力：增幅倍率再度提升，且对相邻两行施加20%的加成。\n*临行增幅最多叠加2次。")
	register_card_info_island("thalia","基础能力：巨幅增加周围5x5追踪类卡片的攻击力，倍率为[攻击力]/100。\n *星级影响[增幅倍率]，技能影响[冷却时间]。\n\n三转能力：增幅倍率提升20%。\n\n四转能力：范围提升至5×7，增幅倍率再次小幅提升。\n\n终转能力：增幅可叠加一次。")
	register_card_info_island("ymir","基础能力：向前方三行投出共6发巨锤，带有45%溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：中路增加一发巨锤，攻击力提升10%，溅射伤害提升至50%。\n\n四转能力：侧路各增加一发巨锤，攻击力再提升10%，击杀附带灰烬效果\n\n终转能力：每路增加一发巨锤，攻击力再额外提升20%")
	
}